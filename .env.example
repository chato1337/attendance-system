# Copie este archivo a .env para desarrollo local fuera de Docker.
# Con docker compose los valores de infra/docker-compose.yml tienen prioridad.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-attendance-secret-key-32b
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,nginx
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080

POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgres://attendance:attendance@localhost:5433/attendance

REDIS_URL=redis://localhost:6379/0

# Llave Fernet de desarrollo. En producción genere otra y no reutilice esta.
FIELD_ENCRYPTION_KEY=9ABHw7khRINU5hwTHBX-eRy9vK8ttpqxQIzsHU3CNLQ=

# Valores por defecto de la plataforma Face-Auth. app_id y api_key viven por
# organización en la base de datos, no aquí.
FACEAUTH_WEB_URL=http://localhost:8090
FACEAUTH_API_URL=http://localhost:8090/api/v1
